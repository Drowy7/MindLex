# MindLex: шаблон окружения.
#
# Скопируйте в .env и подставьте свои значения:
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux / macOS / Git Bash:  cp .env.example .env
#
# Фактор III (Config): все значения читаются из окружения,
# в коде нет ни одного секрета или адреса.

# --- База данных PostgreSQL (фактор IV: внешний ресурс) ---
MINDLEX_DB_NAME=mindlex
MINDLEX_DB_USER=mindlex
MINDLEX_DB_PASSWORD=change-me
MINDLEX_DB_POOL_SIZE=10

# --- HTTP ---
PORT=8080

# --- Безопасность ---
# Секрет подписи JWT. Минимум 32 байта, иначе сервис не стартует.
# Сгенерировать: openssl rand -base64 48
MINDLEX_JWT_SECRET=change-me-please-32-bytes-minimum-secret
# Время жизни токена в формате ISO-8601 Duration (PT12H = 12 часов)
MINDLEX_JWT_TTL=PT12H
# Через запятую, без пробелов. Для Android-клиента можно оставить как есть.
MINDLEX_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Логирование ---
# Уровни: TRACE, DEBUG, INFO, WARN, ERROR
MINDLEX_LOG_LEVEL=INFO
MINDLEX_APP_LOG_LEVEL=INFO

# --- Правила практики ---
# NEW_WORDS_LIMIT — сколько новых слов подряд давать в сессии
# RUSH_SECONDS   — длительность раунда Timed Rush
# CLOZE_SECONDS  — таймер на одно задание Contextual Cloze
MINDLEX_NEW_WORDS_LIMIT=50
MINDLEX_RUSH_SECONDS=90
MINDLEX_CLOZE_SECONDS=35

# --- Демонстрационный пользователь (admin-процесс при старте) ---
# true  — создаст demo@mindlex.local / demo1234 при первом запуске
# false — рекомендуется для продакшена
MINDLEX_DEMO_USER_ENABLED=true